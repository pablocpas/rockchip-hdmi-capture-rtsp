[Unit]
Description=Rockchip HDMI capture RTSP server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Environment=CONFIG_FILE=/etc/rk-hdmi-streamer.conf
ExecStart=/usr/local/bin/rk-hdmi-streamer --config ${CONFIG_FILE}
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
