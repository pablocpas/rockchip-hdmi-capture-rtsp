# Defaults for rk-hdmi-streamer.service.
# Copy to /etc/default/rk-hdmi-streamer and edit for your device.

DEVICE=/dev/v4l/by-id/usb-MACROSILICON_USB3_Video_20210623-video-index0
AUDIO_DEVICE=hw:CARD=Video,DEV=0
AUDIO_CODEC=opus
AUDIO_GAIN=3.0
AUDIO_FRAME_MS=20
STREAM_PROFILE=mjpeg
# Valid profiles:
#   mjpeg       - default/recommended, UVC MJPEG -> MPP JPEG -> MPP H.264
#   rga         - Rockchip optimized, UVC YUYV DMA-BUF -> RGA NV12 -> MPP H.264
#   yuyv-libyuv - fallback/debug, UVC YUYV -> libyuv NV12 -> MPP H.264
# Optional override for STREAM_PROFILE=rga when librga.so is not in the system linker path.
# RGA_LIBRARY=/home/pi/librga/libs/Linux/gcc-aarch64/librga.so
WIDTH=1920
HEIGHT=1080
FPS=50
BITRATE=18000000
GOP=50
RTP_PAYLOAD=1400
CPU_GOVERNOR=performance
LISTEN_RTSP=:8554
RTSP_PATH=/capture
MAX_CLIENTS=3
RTSP_DEBUG=0
