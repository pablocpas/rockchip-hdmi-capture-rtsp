# Defaults for rk-hdmi-streamer.service.
# Copy to /etc/default/rk-hdmi-streamer and edit for your device.

DEVICE=/dev/video0
AUDIO_DEVICE=hw:CARD=MS2109,DEV=0
AUDIO_CODEC=opus
AUDIO_GAIN=3.0
WIDTH=1920
HEIGHT=1080
FPS=30
BITRATE=12000000
GOP=30
RTP_PAYLOAD=12000
LISTEN_RTSP=:8554
RTSP_PATH=/capture
MAX_CLIENTS=3
