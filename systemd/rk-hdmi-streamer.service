[Unit]
Description=Rockchip HDMI capture streamer to MediaMTX
Wants=network-online.target
After=network-online.target mediamtx.service

[Service]
Type=simple
EnvironmentFile=-/etc/default/rk-hdmi-streamer
Environment=DEVICE=/dev/v4l/by-id/usb-MACROSILICON_USB3_Video_20210623-video-index0
Environment=AUDIO_DEVICE=hw:CARD=Video,DEV=0
Environment=VIDEO_CODEC=h264
Environment=AUDIO_CODEC=opus
Environment=AUDIO_GAIN=3.0
Environment=AUDIO_FRAME_MS=20
Environment=STREAM_PROFILE=mjpeg
Environment=WIDTH=1920
Environment=HEIGHT=1080
Environment=FPS=50
Environment=BITRATE=18000000
Environment=GOP=50
Environment=RTP_PAYLOAD=1400
Environment=CPU_GOVERNOR=performance
Environment=OUTPUT=rtsp://127.0.0.1:8554/capture
ExecStartPre=+/bin/sh -c 'for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do [ -w "$g" ] && printf "%%s\n" "$CPU_GOVERNOR" > "$g" || true; done'
ExecStart=/usr/local/bin/rk-hdmi-streamer --stream-profile ${STREAM_PROFILE} --device ${DEVICE} --video-codec ${VIDEO_CODEC} --audio-device ${AUDIO_DEVICE} --audio-codec ${AUDIO_CODEC} --audio-gain ${AUDIO_GAIN} --audio-frame-ms ${AUDIO_FRAME_MS} --width ${WIDTH} --height ${HEIGHT} --fps ${FPS} --bitrate ${BITRATE} --gop ${GOP} --rtp-payload ${RTP_PAYLOAD} --output ${OUTPUT}
Restart=always
RestartSec=2
Nice=-5

[Install]
WantedBy=multi-user.target
