[Unit]
Description=Rockchip HDMI capture streamer to MediaMTX
Wants=network-online.target
After=network-online.target mediamtx.service

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=video audio render
EnvironmentFile=-/etc/default/rk-hdmi-streamer
Environment=DEVICE=/dev/video0
Environment=AUDIO_DEVICE=plughw:CARD=MS2109,DEV=0
Environment=AUDIO_CODEC=opus
Environment=AUDIO_GAIN=3.0
Environment=WIDTH=1920
Environment=HEIGHT=1080
Environment=FPS=30
Environment=BITRATE=12000000
Environment=GOP=30
Environment=RTP_PAYLOAD=1400
Environment=OUTPUT=rtsp://127.0.0.1:8554/capture
ExecStart=/usr/local/bin/rk-hdmi-streamer --decoder mppjpeg --v4l2-dmabuf --device ${DEVICE} --audio-device ${AUDIO_DEVICE} --audio-codec ${AUDIO_CODEC} --audio-gain ${AUDIO_GAIN} --width ${WIDTH} --height ${HEIGHT} --fps ${FPS} --bitrate ${BITRATE} --gop ${GOP} --rtp-payload ${RTP_PAYLOAD} --output ${OUTPUT}
Restart=always
RestartSec=2
Nice=-5

[Install]
WantedBy=multi-user.target
